local function getRoot()
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart")
end

local function removeParts(parts)
	if #parts > 0 then
		invoke("Remove", parts)
	end
end

local function buildText()
	if building then
		return
	end

	building = true
	buildBtn.Text = "BUILDING..."

	local success, result = pcall(function()
		local root = getRoot()

		if not root then
			error("No character found")
		end

		local text = string.upper(textInput.Text)

		if #text == 0 then
			error("Enter some text first")
		end

		local size = math.clamp(
			tonumber(sizeInput.Text) or 1,
			0.2,
			10
		)

		local look = root.CFrame.LookVector
		local origin = root.Position + look * 3 + Vector3.new(0, 4, 0)
		local base = CFrame.lookAt(origin, origin + look)

		local parts = {}
		local resizeChanges = {}
		local colorChanges = {}
		local materialChanges = {}
		local anchorChanges = {}
		local collisionChanges = {}

		local totalCols = #text * 6 - 1
		local startX = -((totalCols - 1) / 2) * size

		for i = 1, #text do
			local ch = string.sub(text, i, i)
			local glyph = glyphs[ch]

			if glyph then
				local colOffset = (i - 1) * 6
				local hue = (i - 1) / math.max(#text, 1)
				local color = Color3.fromHSV(hue, 0.6, 1)

				for row = 1, 7 do
					for col = 1, 5 do
						if string.sub(glyph[row], col, col) == "#" then
							local x = startX + (colOffset + col - 1) * size
							local y = (7 - row) * size
							local cf = base * CFrame.new(x, y, 0)

							local part = invoke(
								"CreatePart",
								"Normal",
								cf,
								workspace
							)

							if not part then
								error("F3X failed to create part")
							end

							table.insert(parts, part)

							table.insert(resizeChanges, {
								Part = part,
								Size = Vector3.new(size, size, size),
								CFrame = cf
							})

							table.insert(colorChanges, {
								Part = part,
								Color = color
							})

							table.insert(materialChanges, {
								Part = part,
								Material = Enum.Material.SmoothPlastic,
								Transparency = 0,
								Reflectance = 0
							})

							table.insert(anchorChanges, {
								Part = part,
								Anchored = true
							})

							table.insert(collisionChanges, {
								Part = part,
								CanCollide = true
							})
						end
					end
				end
			end
		end

		if #parts == 0 then
			error("No supported characters")
		end

		status.Text = "Applying block settings..."

		invoke("SyncResize", resizeChanges)
		invoke("SyncColor", colorChanges)
		invoke("SyncMaterial", materialChanges)
		invoke("SyncAnchor", anchorChanges)
		invoke("SyncCollision", collisionChanges)

		return parts
	end)

	if success then
		table.insert(builtModels, result)
		status.Text = "Built " .. #result .. " blocks"
	else
		status.Text = "Error: " .. tostring(result)
		warn(result)
	end

	building = false
	buildBtn.Text = "BUILD TEXT"
end

buildBtn.MouseButton1Click:Connect(buildText)

undoBtn.MouseButton1Click:Connect(function()
	if building then
		return
	end

	local last = table.remove(builtModels)

	if last then
		local success, err = pcall(function()
			removeParts(last)
		end)

		status.Text = success and "Undid last build" or "Undo failed"
		if not success then
			warn(err)
		end
	else
		status.Text = "Nothing to undo"
	end
end)

clearBtn.MouseButton1Click:Connect(function()
	if building then
		return
	end

	local allParts = {}

	for _, parts in ipairs(builtModels) do
		for _, part in ipairs(parts) do
			table.insert(allParts, part)
		end
	end

	if #allParts == 0 then
		status.Text = "Nothing to clear"
		return
	end

	local success, err = pcall(function()
		removeParts(allParts)
	end)

	if success then
		table.clear(builtModels)
		status.Text = "Cleared all text"
	else
		status.Text = "Clear failed"
		warn(err)
	end
end)
