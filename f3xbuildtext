local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local function findF3X()
	local containers = {
		player:FindFirstChildOfClass("Backpack"),
		player.Character,
		ReplicatedStorage
	}

	for _, container in ipairs(containers) do
		if container then
			for _, v in ipairs(container:GetDescendants()) do
				if v.Name == "SyncAPI" then
					local endpoint = v:FindFirstChild("ServerEndpoint")
					if endpoint and endpoint:IsA("RemoteFunction") then
						return endpoint
					end
				end
			end
		end
	end
end

local endpoint = findF3X()

if not endpoint then
	warn("you dont have f3x ;btools")
	return
end

local function invoke(action, ...)
	return endpoint:InvokeServer(action, ...)
end

